# Configuration Globale de l'API
PROJECT_NAME="Portfolio API"
VERSION="1.0.0"
API_V1_STR="/api"

# Base de Données PostgreSQL (Neon / Supabase / Local)
DATABASE_URL="postgresql://utilisateur:mot_de_passe@localhost:5432/nom_de_la_bdd"

# Sécurité & Authentification JWT
# Générez une clé robuste en production avec : openssl rand -hex 32
SECRET_KEY="remplacer_par_une_cle_secrete_tres_longue_et_aleatoire"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Origines CORS autorisées (séparées par des virgules)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://votre-site.netlify.app"
